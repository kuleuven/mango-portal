</div>


 <!-- Download meta data-->

  <div class="modal fade"
       id="downloadMetaData"
       tabindex="-1"
       aria-labelledby="downloadMetaDataLabel"
       aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addMetaDataLabel">Download metadata</h5>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="Close"></button>
        </div>
        <form action="{{url_download}}"
              method="post"
              enctype="multipart/form-data"
              class="row g-3 needs-validation"
              novalidate>
          <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
          <input type="hidden" name="redirect_hash" value="#metadata" />
          <div class="modal-body">
          <div> 
                   <input 
                       type="checkbox"
                       id="select_all"
                       aria-label="Select all rows"
                        />
    <label for="select_all"> Select all </label>
                <span id="badge" hidden="true" class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-primary"> 0 </span>

    </div>

<div id="schema_checkboxes"> 



          
            {% for schema in grouped_metadata %}
              <div>
    <input 
    type="checkbox" 
    value="{{schema}}" 
    name="metadata" 
     />
    <label for="{{schema}}"> {{schema }} </label>
  </div>
    {% endfor %}


  


        <input type="hidden"
               id="{{type}}-path-download"
               name="{{type}}-path"
               value="{{ object.path }}" />

</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" type="submit">Download</button>
      </div>
    </form>
  </div>
</div>
</div>
<script> 

const mbody = document.querySelector('#downloadMetaData');
const mbody_checkboxes = mbody.querySelectorAll('#schema_checkboxes input[type="checkbox"]');
const mbadge_counter = mbody.querySelector('span#badge');
const mselect_all = mbody.querySelector('input#select_all');


// select all 
mselect_all.addEventListener('change', () => {
  if ( mselect_all.checked) {  // if select all checked : check all + show counter
    mbody_checkboxes.forEach((el) => el.checked = true);
        mbadge_counter.hidden = false;

  mbadge_counter.innerHTML = mbody_checkboxes.length 
} else {  // if select all not checked : uncheck all + hide counter
  mbody_checkboxes.forEach((el) => el.checked = false);
      mbadge_counter.hidden = true;
 
}

})

// select individual 
mbody_checkboxes.forEach((checkbox) => {
  checkbox.addEventListener('change', () => {
    let are_checked = [...mbody_checkboxes].filter((el) => el.checked);  
    mbadge_counter.innerHTML = are_checked.length

  if (are_checked.length < [...mbody_checkboxes].length )  { // if not all boxes are checked : hide counter + uncheck all
        mbadge_counter.hidden = false;
        mselect_all.checked = false;
  }
  if (are_checked.length == 0)  {  // if no boxes are checked:  hide counter
    mbadge_counter.hidden = true;
  }
  })
})

</script>