{% extends "base_openid.html.j2" %}
{% block body %}
    <h3>Login to Mango, your Active Data Repository</h3>
    <p class="mb-4">Please select the infrastructure you want to login to</p>
    <form action="{{ url_for('data_platform_user_bp.login_openid') }}"" method="post">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
        <div class="form-group mb-3">
            <label for="portal">Login Provider</label>
            <select class="form-select" name="portal" id="portal">
                {% for portal in portals %}
                    <option value="{{ portal }}"
                            {% if portal == last_portal %}selected{% endif %}>
                        {{ portals[portal]['label'] }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <input type="submit" value="Log In" class="btn btn-block btn-primary mb-3"/>
    </form>
{% endblock body %}
