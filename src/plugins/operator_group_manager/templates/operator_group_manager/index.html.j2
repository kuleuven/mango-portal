{% extends "base.html.j2" %}
{% import "dialogs.html.j2" as dialogs %}
{% block body %}
    {% if groups and realm %}
        <h4>Group manager for realm {{ realm }}</h4>
        <ul class="list-group">
            {% for group in groups %}
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 col-9">
                        <a href="{{ url_for('operator_group_manager_admin_bp.view_members', realm = realm, group = group.name) }}"
                           class="list-group-item list-group-item-action"><i class="bi bi-people"></i> {{ group.name }}</a>
                    </div>
                    {% if group.name in protected_groups or not editable %}
                        <span><i class="bi bi-lock" title="Read only"></i></span>
                    {% else %}
                        {{ dialogs.confirm_delete_dialog('delete_group_'~group.id, url_for("operator_group_manager_admin_bp.remove_group",  realm=realm) , title = 'Delete this group', button_title='<i class="bi bi-trash"></i>', readonly_fields=[{'name': 'group_name', 'label': 'Group name', 'value': group.name}]) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if editable %}
            <div class="d-flex align-items-center mt-3">
                <div>
                    {{ dialogs.general_dialog("add_group", url_for("operator_group_manager_admin_bp.add_group", realm=realm) ,
                    title="Add custom group", hidden_fields = [{"name":"realm", "value": realm}], fields=[{"name": "group_name_suffix", "label": "Group name suffix "+realm+"_[suffix]","placeholder": "suffix", "value": ""}])
                    }}
                </div>
                {% if missing_semantic_suffixes %}
                    <div class="ms-3">or</div>
                    <div>
                        <form id="add-semantic-group"
                              class="form"
                              method="post"
                              action="{{ url_for("operator_group_manager_admin_bp.add_group", realm=realm) }}">
                            <select id="missing-suffixes"
                                    name="group_name_suffix"
                                    class="form-select me-5">
                                {% for semantic_suffix in missing_semantic_suffixes %}
                                    <option value="{{ semantic_suffix }}">
                                        {{ semantic_suffix | replace('_', ' ') | trim | capitalize }} [{{ realm }}_{{ semantic_suffix }}]
                                    </option>
                                {% endfor %}
                            </select>
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                        </form>
                    </div>
                    <div>
                        <button form="add-semantic-group" type="submit" class="btn btn-primary">Add special group</button>
                    </div>
                {% endif %}
            </div>
            <hr>
            <h4>Automatic user management with ManGO Flow</h4>
            <form id="add-yaml" class="row align-items-center" method="post" action="{{ url_for("operator_group_manager_admin_bp.add_yaml", realm=realm) }}">
            <div class="col-8">
                <label class="form-label" for="user-management-file">Upload a YAML</label>
                <input class="form-control" id="user-management-file" name="user-management-file" type="file" accept=".yml,.yaml">
            </div>
            <div class="col-4">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
            <button type="submit" id="add-user-management-yaml" class="btn btn-primary" disabled>Upload</button>
            </div>
            <div class="col-12" id="user-management-yaml-contents">
            <input name="user-management-yaml-contents" type="hidden"><br>
            <div class="alert alert-secondary" role="alert">
            </div>
            <pre>
            </pre>
            </div>
            </form>
            <script>
                const form = document.querySelector("form#add-yaml")
                function validateYAML(contentsDiv, submitButton) {
                    const url = '{{ url_for("operator_group_manager_admin_bp.validate_yaml", realm=realm) }}';
                    const yamlFormData = new FormData(form);
                    const yamlValidationRequest = new Request(url, {
                            method: "POST",
                            body: yamlFormData
                        });
                    fetch(yamlValidationRequest)
                        .then((response) => response.json())
                        .then((json) => {
                            const [path, yamlData] = json;
                            const alertElement = contentsDiv.querySelector("div.alert");
                            alertElement.innerHTML = path ? `Valid YAML! It will be stored as <code>${path}</code>` : "YAML is not valid";
                            alertElement.className = path ? "alert alert-secondary" : "alert alert-danger";
                            
                            const preElement = contentsDiv.querySelector("pre");
                            preElement.innerHTML = yamlData;
                            if (path) {
                                contentsDiv.querySelector("input").value = yamlData;
                                submitButton.removeAttribute("disabled");
                            } else {
                                submitButton.setAttribute("disabled", "");
                            }
                    })
                }
                form.querySelector("input#user-management-file").addEventListener("change", (event) => {
                    const reader = new FileReader();
                    reader.readAsText(event.target.files[0]);
                    reader.onload = () => {
                        const contentsDiv = form.querySelector("div#user-management-yaml-contents");
                        contentsDiv.querySelector("input").value = reader.result;
                        validateYAML(contentsDiv, form.querySelector("button#add-user-management-yaml"));
                    }
                } )
            </script>
        {% endif %}
    {% endif %}
    {% if realm and not groups %}<p>No groups found for {{ realm }}</p>{% endif %}
    {% if not realm and realms %}
        <h2>Group manager</h2>
        <p>Please select a realm to continue</p>
        <div class="list-group realms">
            {% for p_realm in realms %}
                <a href="{{ url_for('operator_group_manager_admin_bp.group_manager_index', realm=p_realm) }}"
                   class="list-group-item list-group-item-action"><i class="bi bi-box fs-5"></i> {{ p_realm }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock body %}
