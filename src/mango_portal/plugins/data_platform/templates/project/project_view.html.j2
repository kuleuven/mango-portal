                <td class="align-middle"><code>{{ log['status'] }}</code></td>
                <td class="align-middle">{% if log['hidden'] %}&nbsp;{% else %}{{ log['quota_size']|format_size }}, {{ log['quota_inodes']|format_intword }} inodes{% endif %}</td>
                <td class="align-middle">{{ log['modified_by'] }}</td>
                <td class="align-middle">{{ log['message'] }}</td>
              </tr>
              {% endfor %}
            </table>
          </div>
        </div>
      </div>
    </div>
